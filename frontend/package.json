{
  "name": "edus-library-frontend",
  "private": true,
  "version": "2.0.0-rc.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build && node scripts/build-manifest.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --experimental-strip-types --import ./tests/setup.mjs --test tests/*.test.ts",
    "lint": "eslint src tests",
    "format:check": "prettier --check src tests scripts vite.config.ts eslint.config.js",
    "format": "prettier --write src tests scripts vite.config.ts eslint.config.js"
  },
  "dependencies": {
    "@lucide/vue": "1.46.0",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.3",
    "@vitejs/plugin-vue": "6.0.9",
    "eslint": "10.10.0",
    "eslint-plugin-vue": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vue-tsc": "3.3.11"
  }
}
