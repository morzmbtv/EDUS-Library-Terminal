{
  "name": "edus-library-terminal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "build:terminal-test": "vue-tsc --noEmit && vite build --mode terminal-test --outDir dist-terminal-test",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --experimental-strip-types --import ./tests/setup.mjs --test tests/*.test.ts",
    "lint": "eslint src tests",
    "package:release": "node scripts/package-release.mjs",
    "package:terminal-test": "node scripts/package-terminal-test.mjs",
    "qa:terminal-test": "node scripts/qa-terminal-test.mjs",
    "qa:production-boundary": "node scripts/qa-production-boundary.mjs"
  },
  "dependencies": {
    "@lucide/vue": "1.46.0",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.3",
    "@vitejs/plugin-vue": "6.0.9",
    "eslint": "10.10.0",
    "eslint-plugin-vue": "10.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vue-tsc": "3.3.11"
  }
}
